# Sao chép file này thành .env rồi điền giá trị thật.

# Lấy tại https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Token bot tạo bằng @BotFather
TG_BOT_TOKEN=

# Lấy tại https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Soạn email (không bắt buộc; để trống thì tắt phần này)
# App Password tạo tại https://myaccount.google.com/apppasswords (cần bật xác minh 2 bước)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Bật/tắt màn hình Windows bằng /screen (không bắt buộc). Chuỗi bí mật bất kỳ, >= 16 ký tự.
# Cần chạy thêm host/screen_agent.py trên Windows.
SCREEN_TOKEN=
